 "nodes": [
  {
   "id": "cve-109618",
   "layer": "vulnerability",
   "name": "CVE-2026-109618: RCE via OOM corruption",
   "text": "An out-of-memory condition during request handling could leave request memory in an uninitialised state that later cleanup reads. CVSS v4.0 9.2. GHSA-w8hw-w9fx-j79w.",
   "source": "cve-cve-2026-109618",
   "cvss": "9.2"
  },
  {
   "id": "cve-109619",
   "layer": "vulnerability",
   "name": "CVE-2026-109619: RCE via stale global state",
   "text": "Global state that referenced request memory was not always reset, so a later request on the same worker could read freed memory. CVSS v4.0 9.2. GHSA-6wmf-4rv5-p3rp.",
   "source": "cve-cve-2026-109619",
   "cvss": "9.2"
  },
  {
   "id": "fix-commit",
   "layer": "remediation",
   "name": "The fix commit 3584a98bd",
   "text": "\"Avoid state corruption via bailout\", by Arnaud Le Blanc with Ilija Tovilo, Jakub Zelenka, Nora Dossche and Nicolas Grekas. Authored 2026-10-18 15:26 UTC; public on the branches 2026-10-21 14:06 UTC. 389 files, +10,689 / -976.",
   "source": "github-php-src-fix-commit-3584a98bd",
   "url": "https://github.com/php/php-src/commit/3584a98bda0f2c0d367255b046798b0d3a221a19"
  },
  {
   "id": "fix-soft-limit",
   "layer": "remediation",
   "name": "A soft memory limit that no longer jumps",
   "text": "At the memory limit the allocator stops using the longjmp bailout; it queues a delayed error and lets the allocation proceed, so the fatal is raised later with request state intact.",
   "func": "zend_mm_check_limit, zend_mm_delayed_error",
   "file": "Zend/zend_alloc.c"
  },
  {
   "id": "fix-hard-limit",
   "layer": "remediation",
   "name": "A hard limit that ends the process cleanly",
   "text": "A new memory_hard_limit_percent sets a ceiling above memory_limit; reaching it ends the worker with _exit(), leaving no cleanup to corrupt. zend_mm_panic also uses _exit now.",
   "func": "zend_mm_hard_limit_error",
   "file": "Zend/zend_alloc.c",
   "ini": "memory_hard_limit_percent"
  },
  {
   "id": "fix-unwind",
   "layer": "remediation",
   "name": "An orderly unwind at the next safe point",
   "text": "The queued error is handled at a VM safe point: it throws an UnwindExit that unwinds the PHP frames in order before the fatal, rather than a C longjmp across half-built state.",
   "func": "zend_handle_delayed_oom, zend_throw_unwind_exit",
   "file": "Zend/zend_execute_API.c"
  },
  {
   "id": "fix-reset-globals",
   "layer": "remediation",
   "name": "Request globals reset so nothing survives a failure",
   "text": "Shutdown and deactivate paths set freed pointers to NULL or UNDEF, 'may be accessed before php_request_startup()', so a later request cannot find stale state.",
   "func": "shutdown_executor, php_request_shutdown, sapi_deactivate",
   "file": "Zend/zend_execute_API.c, main/main.c, main/SAPI.c"
  },
  {
   "id": "fix-bounded-parsing",
   "layer": "remediation",
   "name": "Bounded, deduplicated request parsing",
   "text": "A new max_multipart_body_parts caps the number of parts the body parser accepts; the multipart header parser keeps only the two headers it uses and ignores duplicates; the session upload-progress callback is changed.",
   "func": "multipart_buffer_headers, rfc1867_post_handler",
   "file": "main/rfc1867.c, ext/session/session.c",
   "ini": "max_multipart_body_parts"
  },
  {
   "id": "fix-fallible",
   "layer": "remediation",
   "name": "Allocations that may fail instead of abort",
   "text": "Allocation paths a caller can tolerate failing become 'fallible' and return NULL rather than jumping, which is what lets the new tests exercise the OOM handling at any allocation.",
   "func": "fallible allocation family",
   "file": "Zend/zend_alloc.c, Zend/zend_hash.c, Zend/zend_string.c"
  },
